# Copy to .env for local development and adjust as needed.
# The app and Alembic both read DATABASE_URL from the environment.

DATABASE_URL=postgresql+psycopg://limbitless:limbitless@localhost:5432/limbitless

# JWT auth. Set JWT_SECRET_KEY to a strong random value anywhere that
# isn't a developer's machine.
JWT_SECRET_KEY=dev-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Browser origins allowed to call the API (comma-separated). Defaults to
# the local Angular dev server if unset.
CORS_ALLOW_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Notification email delivery (Section 5.6). EMAIL_BACKEND is "noop"
# (default, nothing sent), "console" (message logged), or "smtp".
EMAIL_BACKEND=noop
EMAIL_FROM=no-reply@limbitless.example
# Only used when EMAIL_BACKEND=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Shared secret a scheduler presents (X-Dispatch-Token header) to run
# POST /notifications/dispatch-due. Empty -> that endpoint returns 503.
NOTIFICATIONS_DISPATCH_TOKEN=
EMAIL_DISPATCH_MAX_AGE_DAYS=7
# In-process scheduler: run the maintenance pass every N minutes while
# the API is up. 0 disables it (use the endpoint above or
# `python -m scripts.run_maintenance` from cron instead).
MAINTENANCE_INTERVAL_MINUTES=0
